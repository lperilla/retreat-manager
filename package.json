{
  "name": "retreat-manager",
  "productName": "Gestión del retiro",
  "version": "0.1.0",
  "description": "Dashboard, batch exporter and printing system for retreat letters received in a shared Gmail inbox.",
  "author": {
    "name": "Gestión del retiro"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/entrypoints/web.js",
    "dev": "node --watch src/entrypoints/web.js",
    "auth": "node src/entrypoints/auth.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:purge": "node src/entrypoints/purge.js",
    "demo:walkthrough": "node scripts/demo-walkthrough.js",
    "seed:gmail": "node scripts/seed-gmail.js",
    "desktop": "electron desktop/main.mjs",
    "dist": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux deb AppImage --x64"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "googleapis": "189.0.0",
    "mammoth": "1.13.0",
    "mongodb": "7.8.0",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "main": "desktop/main.mjs",
  "devDependencies": {
    "electron": "43.8.12",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.retreat.manager",
    "productName": "Gestión del retiro",
    "copyright": "Gestión del retiro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "desktop/**/*",
      "src/**/*",
      "package.json",
      "!**/*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Gestion-del-retiro-Instalador-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestión del retiro",
      "language": "1034"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Gestion del retiro <noreply@retreat-manager.local>",
      "synopsis": "Gestión del retiro: cartas, participantes, habitaciones y mesas",
      "artifactName": "Gestion-del-retiro-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Gestión del retiro",
          "StartupWMClass": "Gestión del retiro"
        }
      }
    }
  }
}
