{
  "name": "retreat-manager",
  "productName": "Retreat Manager",
  "version": "0.1.3",
  "description": "Dashboard, batch exporter and printing system for retreat letters received in a shared Gmail inbox.",
  "author": {
    "name": "Retreat Manager"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/entrypoints/web.js",
    "dev": "node --watch src/entrypoints/web.js",
    "auth": "node src/entrypoints/auth.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:purge": "node src/entrypoints/purge.js",
    "demo:walkthrough": "node scripts/demo-walkthrough.js",
    "seed:gmail": "node scripts/seed-gmail.js",
    "desktop": "electron desktop/main.mjs",
    "dist": "electron-builder --config electron-builder.win.yml --win nsis --x64",
    "dist:linux": "electron-builder --config electron-builder.linux.yml --linux deb AppImage --x64",
    "dist:win": "electron-builder --config electron-builder.win.yml --win nsis --x64"
  },
  "dependencies": {
    "@googleapis/gmail": "22.1.0",
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "mammoth": "1.13.0",
    "mongodb": "7.8.0",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "main": "desktop/main.mjs",
  "devDependencies": {
    "electron": "43.8.12",
    "electron-builder": "26.15.3"
  }
}
