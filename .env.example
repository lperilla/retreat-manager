# retreat-manager configuration. Copy to .env and adjust.
# .env is git-ignored: never commit real credentials.
# Paths are relative to the project root (not to the current working directory).

# --- Web server -------------------------------------------------------------
# Interface to bind. 127.0.0.1 = this computer only (recommended).
# Use 0.0.0.0 to expose the dashboard on the local network (ACCESS_TOKEN becomes mandatory).
HOST=127.0.0.1
# HTTP port of the dashboard.
PORT=3000
# Shared access code (>= 16 characters) required when HOST is not a loopback address.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=

# --- Locale -----------------------------------------------------------------
# IANA time zone used for dates, the afterDate filter and export file names.
TZ=Europe/Madrid

# --- Demo mode --------------------------------------------------------------
# true = in-memory stores + fictitious letters released in 3 waves (no Gmail, no database).
DEMO_MODE=false

# --- Assignment heuristics ----------------------------------------------------
# Minimum confidence (0..1) to auto-assign a letter; below it the letter goes to review.
ASSIGNMENT_MIN_CONFIDENCE=0.75
# Characters at the start of the body where salutations ("Querido Juan:") are searched.
BODY_SCAN_CHARS=600

# --- Participants -------------------------------------------------------------
# Optional JSON list of participants imported ONCE into an empty retreat (see participants.example.json).
# Afterwards participants are managed in the dashboard (Participantes) and this file is not read again.
PARTICIPANTS_FILE=./data/participants.json
# Days after the last day of the retreat before ALL its personal data is deleted automatically
# (participants with their allergies, needs and emergency contacts, letters, print status,
# attachment cache and exports). Set the retreat dates in the dashboard (Participantes).
RETREAT_RETENTION_DAYS=30

# --- Gmail --------------------------------------------------------------------
# Gmail search that selects the retreat letters, e.g. to:cartas.retiro.2026@gmail.com (dedicated mailbox, recommended)
GMAIL_QUERY=
# Alternative to GMAIL_QUERY: internal Gmail label id (e.g. Label_1234567890). Overrides the query.
GMAIL_LABEL_ID=
# First day (YYYY-MM-DD, local day in TZ) whose mail is read, from any sender. Combines with GMAIL_QUERY / GMAIL_LABEL_ID.
# Changing GMAIL_QUERY, GMAIL_LABEL_ID or GMAIL_START_DATE makes the next sync a full one automatically.
GMAIL_START_DATE=
# OAuth client downloaded from Google Cloud (Desktop app) and the token written by `npm run auth`.
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
# Parallel message downloads during a sync (1-20).
GMAIL_CONCURRENCY=5
# Maximum message downloads per second (0 = unlimited). Lower it if Gmail answers "Quota exceeded" during a full sync.
GMAIL_MAX_REQUESTS_PER_SECOND=5
# Gmail labels (opt-in): one label per participant plus a printed label, applied to the messages.
# Needs the broader gmail.modify scope: run "npm run auth" again after enabling it.
GMAIL_LABELS_ENABLED=false
# Optional prefix: with "Retiro" labels are named "Retiro/<participant name>"; empty = just the participant name.
GMAIL_LABEL_PREFIX=
# Label added to a message once it has been printed.
GMAIL_PRINTED_LABEL=Impreso

# --- Files ----------------------------------------------------------------------
# Where batch exports (.html/.txt/.json) are written.
EXPORT_DIR=./exports
# Disk cache for downloaded attachments (letters themselves are never cached on disk).
CACHE_DIR=./cache
# Maximum size of an attachment that will be downloaded and processed, in MB.
MAX_ATTACHMENT_MB=15

# --- Persistence ----------------------------------------------------------------
# mongo (recommended) or json (file-based fallback, single process only).
PERSISTENCE=mongo
# Directory of the JSON stores when PERSISTENCE=json.
DATA_DIR=./data
# MongoDB connection (local, Atlas or compatible). URL-encode special characters in the password.
# Must match MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD when using docker-compose.yml.
MONGODB_URI=mongodb://retreat_admin:change-this-password@127.0.0.1:27017
# Database name.
MONGODB_DB=retreat_mail
# Optional: enables the MongoDB integration tests (uses throwaway databases on this server).
MONGODB_URI_TEST=

# --- docker-compose.yml (local MongoDB) -----------------------------------------
# Root credentials of the MongoDB container (required by docker compose).
MONGO_ROOT_USERNAME=retreat_admin
MONGO_ROOT_PASSWORD=change-this-password
# Host port published on 127.0.0.1 only.
MONGO_PORT=27017

# --- Synchronization --------------------------------------------------------------
# Automatic incremental sync every N minutes (web server only). 0 = off.
SYNC_INTERVAL_MINUTES=0
# Minimum seconds between two syncs (manual, automatic or MCP).
SYNC_MIN_INTERVAL_SECONDS=30
# Sync lock lifetime in seconds (renewed while a sync runs; protects against crashed processes).
SYNC_LOCK_TTL_SECONDS=300
# Days the sync history is kept (MongoDB TTL index / JSON pruning).
SYNC_RUNS_TTL_DAYS=90

# --- Logging ------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent. Logs never include letter bodies or credentials.
LOG_LEVEL=info
