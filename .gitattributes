# Normalize line endings to LF in the repository (Windows checkouts keep working).
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.docx binary
*.mov binary
*.heic binary

# Shell scripts must keep LF; Windows batch files need CRLF
*.sh text eol=lf
*.cmd text eol=crlf
